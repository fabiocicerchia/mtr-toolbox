#!/usr/bin/env bash
# netreport [host] — one-shot connectivity snapshot for incident notes:
# links, addresses, routes, DNS, and (with a host) latency + path.
set -uo pipefail
HOST="${1:-}"

section() { printf '\n===== %s =====\n' "$1"; }

section "LINKS";  ip -brief link
section "ADDRS";  ip -brief addr
section "ROUTES"; ip route
section "DNS";    cat /etc/resolv.conf

if [[ -n "$HOST" ]]; then
  section "RESOLVE $HOST"; dig +short "$HOST" || true
  section "PING $HOST";    ping -c 3 -W 2 "$HOST" || true
  section "PATH $HOST";    mtr --report --report-cycles 5 "$HOST" || true
fi
